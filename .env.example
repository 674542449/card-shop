APP_NAME=CardShop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# 必须填站点的真实对外地址，含协议。用了 HTTPS 就要写 https:// —— 这个值决定
# Laravel 生成的样式表、脚本、canonical 和 og:url 用哪个协议，填错会让 HTTPS
# 页面因混合内容加载不到 CSS。
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cardshop
DB_USERNAME=cardshop
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
# Leave unset to follow APP_URL: https:// turns the Secure flag on, plain http keeps
# it off so a non-TLS install can still log in. Set it explicitly only to override.
SESSION_SECURE_COOKIE=
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# First-run administrator. Leave ADMIN_PASSWORD empty and a random one is generated
# and printed once to the container log on first boot. Minimum 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 性能参数 ----
# 不要手填这些：跑 ./install.sh，它会读取本机 CPU 和内存算出推荐值并让你选。
# 留空则使用镜像默认值（PHP-FPM 只有 5 个工作进程，仅够测试）。
PHP_FPM_MAX_CHILDREN=
PHP_FPM_START_SERVERS=
PHP_FPM_MIN_SPARE=
PHP_FPM_MAX_SPARE=
POSTGRES_SHARED_BUFFERS=
POSTGRES_EFFECTIVE_CACHE=
POSTGRES_WORK_MEM=
POSTGRES_MAX_CONNECTIONS=

# ---- 反向代理 / CDN ----
# 站点挂在 CDN 或反向代理后面时必须设置，否则：
#   1) 所有访客的 IP 都是 CDN 的，按 IP 的限流和黑名单会失效
#   2) Laravel 生成 http:// 链接，HTTPS 页面会因混合内容拒绝加载样式表
# 填 CDN 的回源 IP 段（逗号分隔），或填 * 表示信任所有代理。
# 用 * 之前请先把 80 端口只放行给 CDN —— 否则任何人都能直连源站伪造自己的 IP。
TRUSTED_PROXIES=
