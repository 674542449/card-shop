APP_NAME=CardShop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# 必须填站点的真实对外地址，含协议。用了 HTTPS 就要写 https:// —— 这个值决定
# Laravel 生成的样式表、脚本、canonical 和 og:url 用哪个协议，填错会让 HTTPS
# 页面因混合内容加载不到 CSS。
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cardshop
DB_USERNAME=cardshop
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
# Leave unset to follow APP_URL: https:// turns the Secure flag on, plain http keeps
# it off so a non-TLS install can still log in. Set it explicitly only to override.
SESSION_SECURE_COOKIE=
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# First-run administrator. Leave ADMIN_PASSWORD empty and a random one is generated
# and printed once to the container log on first boot. Minimum 12 characters.
# 后台挂载的路径。默认 admin，也就是 https://你的域名/admin
#
# 改成别的（如 ADMIN_PATH=my-panel）之后，/admin 会直接 404，后台和它的 API 一起
# 搬到新路径下。前端是运行时读这个值的，改完不需要重新构建 SPA。
#
# 这是「安全靠隐藏」：它能挡住满世界扫 /admin、/wp-admin 的自动化机器人，让日志
# 干净很多，但挡不住有针对性的攻击者。真正保护后台的是下面这个强密码、登录限流、
# Turnstile 和 IP 黑名单 —— 换个门牌不能替代其中任何一样。
#
# 只允许字母数字和 - _，最长 32 位；填了非法值或与前台路由冲突的保留字会退回 admin。
ADMIN_PATH=admin

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 性能参数 ----
# 不要手填这些：跑 ./install.sh，它会读取本机 CPU 和内存算出推荐值并让你选。
# 留空则使用镜像默认值（PHP-FPM 只有 5 个工作进程，仅够测试）。
PHP_FPM_MAX_CHILDREN=
PHP_FPM_START_SERVERS=
PHP_FPM_MIN_SPARE=
PHP_FPM_MAX_SPARE=
POSTGRES_SHARED_BUFFERS=
POSTGRES_EFFECTIVE_CACHE=
POSTGRES_WORK_MEM=
POSTGRES_MAX_CONNECTIONS=

# ---- 反向代理 / CDN ----
# 挂 Cloudflare 的标准部署：这里保持为空，不要填任何值。
#
# 真实访客 IP 由 nginx 还原：docker/nginx/default.conf 里配了 Cloudflare 的全部
# 回源网段（set_real_ip_from）加 real_ip_header CF-Connecting-IP。nginx 只在对端
# 确实属于这些网段时才改写 $remote_addr，所以 PHP 从 REMOTE_ADDR 拿到的已经是真实
# IP，Laravel 不需要再信任任何代理。
#
# 千万不要填 *。那等于「谁连过来都信它自称的 IP」：任何人直连源站伪造
# X-Forwarded-For，就能绕过限流、绕过每 IP 最多 3 笔未支付订单的限制、绕过 IP
# 黑名单。nginx 那套方案没有这个弱点，因为伪造者没办法让自己的包从 Cloudflare
# 的网段发出来。
#
# 只有一种情况需要填：nginx 之外还套了别的反向代理（自建 HAProxy、Nginx Proxy
# Manager、非 Cloudflare 的 CDN）。这时填那一层的回源网段，逗号分隔，仍然不要填 *。
TRUSTED_PROXIES=

# ---- HTTPS 证书目录（宿主机路径）----
# docker-compose.yml 会把它挂到 nginx 的 /etc/nginx/cf（只读）。里面需要放
# Cloudflare 源站证书的 cert.pem 和 key.pem。放好后还要执行：
#   cp docker/nginx/tls/ssl.conf.example docker/nginx/tls/ssl.conf
# 否则 nginx 不会监听 443（default.conf 里那条 include 匹配不到文件）。
# 现象会是「443 端口通了但连不上 HTTPS」，很容易误判成证书问题。
TLS_CERT_DIR=/opt/cf
